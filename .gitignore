.venv/
__pycache__/
*.pyc
.DS_Store
.pytest_cache/
*.egg-info/
node_modules/
.next/
dist/
build/
.env
.env.*
!.env.example
*.log
data/benchmarks/*/raw/

# Root-level data/ is the backend's runtime state (SQLite DB, uploaded
# files) -- anchored to the repo root so this does NOT match research/data/,
# which holds real, versioned project artifacts (OHR-Bench adapter output,
# the EAR calibration model, etc.) and must stay tracked.
/data/

# PID files written by scripts/start.sh / read by scripts/stop.sh -- pure
# runtime state, meaningless (and potentially stale/misleading) on another
# machine or after a reboot.
/.run/
