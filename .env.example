# Copy to .env and adjust. Nothing here has a real secret in it -- this is a template.

# --- Backend (backend/config.py) ---
# Default: SQLite, no server process needed. For the optional Postgres/pgvector
# profile: postgresql+psycopg://quimrag:<password>@localhost:5432/quimrag
DATABASE_URL=sqlite:///./data/quimrag.db

# Leave blank to disable auth (default, fine for the single-machine/local
# target -- see docs/production/ARCHITECTURE_DECISIONS.md #6). Set a real
# random value to require `Authorization: Bearer <value>` on every request.
QUIMRAG_API_KEY=

QUIMRAG_MAX_UPLOAD_BYTES=26214400
QUIMRAG_MAX_PAGE_COUNT=500

# local (Ollama, default) | extractive (no model call) | anthropic (requires ANTHROPIC_API_KEY)
QUIMRAG_GENERATION_PROVIDER=local

# Only used if QUIMRAG_GENERATION_PROVIDER=anthropic is explicitly requested --
# never used implicitly, per Phase 7's "never silently send private documents
# to an external API".
ANTHROPIC_API_KEY=

# Where Ollama is reachable. On Docker Desktop (Mac/Windows), the host
# machine is reachable at host.docker.internal from inside a container.
OLLAMA_HOST=http://localhost:11434

# --- Only needed for the optional `postgres` docker-compose profile ---
POSTGRES_PASSWORD=
